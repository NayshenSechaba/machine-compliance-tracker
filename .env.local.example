# Copy this file to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Without these, the app runs in demo mode with
# sample data so you can preview it before wiring up your database.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
